{
  "better-comments.tags": [
    {
      "backgroundColor": "transparent",
      "bold": false,
      "color": "#FF2D00",
      "italic": false,
      "strikethrough": false,
      "tag": "!",
      "underline": false
    },
    {
      "backgroundColor": "transparent",
      "bold": false,
      "color": "#3498DB",
      "italic": false,
      "strikethrough": false,
      "tag": "?",
      "underline": false
    },
    {
      "backgroundColor": "transparent",
      "bold": false,
      "color": "#474747",
      "italic": false,
      "strikethrough": true,
      "tag": "//",
      "underline": false
    },
    {
      "backgroundColor": "transparent",
      "bold": false,
      "color": "#FF8C00",
      "italic": false,
      "strikethrough": false,
      "tag": "todo",
      "underline": false
    },
    {
      "backgroundColor": "transparent",
      "bold": false,
      "color": "#98C379",
      "italic": false,
      "strikethrough": false,
      "tag": "*",
      "underline": false
    }
  ],
  "conventionalCommits.scopes": [
    "ci",
    "actions",
    "vscode",
    "talos",
    "flux",
    "actions-runner-controller",
    "alertmanager",
    "atuin",
    "bazarr",
    "ceph-csi-drivers",
    "cert-manager",
    "cilium",
    "cloudflare-dns",
    "cloudflare-tunnel",
    "cloudflared",
    "cloudnative-pg",
    "coredns",
    "descheduler",
    "echo",
    "envoy-gateway",
    "external-dns",
    "external-secrets",
    "flaresolverr",
    "flux-operator",
    "gatus",
    "generic-device-plugin",
    "grafana",
    "grafana-operator",
    "homepage",
    "it-tools",
    "k8s-gateway",
    "kopiur",
    "kromgo",
    "kube-prometheus-stack",
    "kyverno",
    "kyverno-policies",
    "mealie",
    "metrics-server",
    "minnieverse",
    "miroir",
    "monitoring",
    "prowlarr",
    "qbittorrent",
    "qui",
    "radarr",
    "radarranime",
    "radarruhd",
    "recyclarr",
    "reloader",
    "rook-ceph",
    "sabnzbd",
    "searxng",
    "seerr",
    "snapshot-controller",
    "sonarr",
    "sonarranime",
    "sonarruhd",
    "spegel",
    "tailscale-operator",
    "tautulli",
    "tuppr",
    "victoria-logs"
  ],
  "files.associations": {
    "**/*.json5": "json5"
  },
  "files.trimTrailingWhitespace": true,
  "material-icon-theme.files.associations": {
    "*.gotmpl": "smarty",
    "helmfile.yaml": "helm",
    "kubeconfig": "kubernetes",
    "talosconfig": "kubernetes"
  },
  "material-icon-theme.folders.associations": {
    // top level
    ".github/workflows": "ci",
    ".private": "archive",
    ".renovate": "robot",
    "bootstrap": "seeders",
    "bootstrap/helmfile.d": "helm",
    "flux": "pipe",
    "talos": "linux",
    // namespaces
    "actions-runner-system": "github",
    "cert-manager": "guard",
    "external-secrets": "secure",
    "flux-system": "pipe",
    "kube-system": "kubernetes",
    "monitoring": "event",
    "networking": "connection",
    "rook-ceph": "dump",
    "system-upgrade": "update",
    // apps
    "kopiur": "aws",
    "cloudflared": "cloudflare",
    "radarr": "video",
    "radarranime": "video",
    "radarruhd": "video",
    "sonarr": "video",
    "sonarranime": "video",
    "sonarruhd": "video",
    "tautulli": "event"
  },
  "mise.binPath": "~/.local/bin/mise",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "sops.defaults.ageKeyFile": "age.key",
  "vs-kubernetes": {
    "vs-kubernetes.knownKubeconfigs": ["./kubeconfig"],
    "vs-kubernetes.kubeconfig": "./kubeconfig"
  },
  "yaml.schemaStore.enable": true,
  "yaml.schemas": {
    "kubernetes": "./kubernetes/**/*.yaml"
  },
  "[json][json5][jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  }
}
