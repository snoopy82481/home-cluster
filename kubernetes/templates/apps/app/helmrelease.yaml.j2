{% set external = (external | string | lower) in ['true','1','yes','y','on'] %}
---
{% if template_type == "app-template" %}
# yaml-language-server: $schema=https://raw.githubusercontent.com/bjw-s/helm-charts/main/charts/other/app-template/schemas/helmrelease-helm-v2.schema.json
{% else %}
# yaml-language-server: $schema=https://k8s-schemas.home-operations.com/helm.toolkit.fluxcd.io/helmrelease_v2.json
{% endif %}
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: &app {{ app_name }}
spec:
  chartRef:
    kind: OCIRepository
    name: {{ app_name }}
  interval: 1h
  values:
{% if template_type == "app-template" %}
    controllers:
      {{ app_name }}:
        containers:
          {{ app_name }}:
            image:
              repository: #! Change this to the app's image repository
              tag: #! Change this to the app's image tag

            env:
              TZ: America/Boise
              PORT: &port 0000 #! Change this to the app's port

            probes:
              liveness: &probes
                enabled: true
                custom: true
                spec:
                  httpGet:
                    path: /ping
                    port: *port
                  initialDelaySeconds: 0
                  periodSeconds: 10
                  timeoutSeconds: 1
                  failureThreshold: 3
              readiness: *probes

            securityContext:
              allowPrivilegeEscalation: false
              readOnlyRootFilesystem: true
              capabilities:
                drop:
                  - "ALL"

            resources:
              requests:
                cpu: 100m
              limits:
                memory: 1Gi

    defaultPodOptions:
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        fsGroupChangePolicy: OnRootMismatch

    service:
      {{ app_name }}:
        controller: {{ app_name }}
        ports:
          http:
            port: *port

    route:
      {{ app_name }}:
        enabled: true
        parentRefs:
        {% if external %}
          - name: envoy-external
            namespace: networking
        {% else %}
          - name: envoy-internal
            namespace: networking
        {% endif %}
        hostnames:
          - "{% raw %}{{ .Release.Name }}{% endraw %}.idahobealefamily.com"

    persistence:
      config:
        existingClaim: "{% raw %}{{ .Release.Name }}{% endraw %}"

      media:
        type: nfs
        server: truenas.internal
        path: /mnt/storage1/data
        globalMounts:
          - path: /media

      tmpfs:
        type: emptyDir
        advancedMounts:
          {{ app_name }}:
            {{ app_name }}:
              - path: /config/logs
                subPath: logs
              - path: /tmp
                subPath: tmp
{% endif %}
