{% set storage  = (storage  | string | lower) in ['true','1','yes','y','on'] %}
---
# yaml-language-server: $schema=https://k8s-schemas.home-operations.com/kustomize.toolkit.fluxcd.io/kustomization_v1.json
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: {{ app_name }}
spec:
  {% if storage %}
  components:
    - ../../../../components/kopiur/backup
  {% endif %}
  interval: 1h
  path: {{ ["./kubernetes/apps", namespace, app_name, "app"] | join("/") }}
  {% if storage %}
  postBuild:
    substitute:
      APP: {{ app_name }}
      KOPIUR_CAPACITY: 1Gi
  {% endif %}
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
  targetNamespace: {{ namespace }}
